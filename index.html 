<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meowl Messenger</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

<!-- АВТОРИЗАЦИЯ -->
<div id="authScreen">

  <div class="auth-card">

    <div class="logo">M</div>

    <h1>Meowl Messenger</h1>
    <p class="subtitle">Общайся. Быстро. Красиво.</p>

    <div class="tabs">
      <button id="loginTab" class="tab active" type="button">
        Войти
      </button>

      <button id="registerTab" class="tab" type="button">
        Регистрация
      </button>
    </div>

    <input
      id="emailInput"
      type="email"
      placeholder="Почта"
    >

    <input
      id="passwordInput"
      type="password"
      placeholder="Пароль"
    >

    <button id="authButton" class="main-button" type="button">
      Войти
    </button>

    <div id="authError"></div>

  </div>

</div>


<!-- МЕССЕНДЖЕР -->
<div id="appScreen">

  <header>

    <div>
      <h2 id="pageTitle">Чаты</h2>
      <div id="emailLabel"></div>
    </div>

    <button id="logoutButton" class="logout-button" type="button">
      Выйти
    </button>

  </header>


  <main>

    <!-- ЧАТЫ -->
    <div id="chatsPage">

      <div class="empty-card">

        <div class="chat-icon">💬</div>

        <h2>Чатов пока нет</h2>

        <p>Здесь будут отображаться твои чаты</p>

      </div>

    </div>


    <!-- ПРОФИЛЬ -->
    <div id="profilePage" class="hidden">

      <div class="profile-card">

        <div class="avatar">

          <img id="avatarImage" alt="">

          <div id="avatarDefault">👤</div>

        </div>

        <h2 id="profileNickname">Ник</h2>

        <p id="profileDescription">
          Описание профиля
        </p>

        <button
          id="editProfileButton"
          class="main-button"
          type="button"
        >
          ✏️ Изменить профиль
        </button>

      </div>


      <!-- РЕДАКТИРОВАНИЕ -->
      <div id="editProfile" class="profile-card hidden">

        <h2>Изменить профиль</h2>

        <button
          id="photoButton"
          class="secondary-button"
          type="button"
        >
          📷 Выбрать фото
        </button>

        <input
          id="photoInput"
          type="file"
          accept="image/*"
          hidden
        >

        <input
          id="nicknameInput"
          type="text"
          placeholder="Ник"
        >

        <textarea
          id="descriptionInput"
          placeholder="Описание"
        ></textarea>

        <input
          id="profileEmail"
          type="email"
          readonly
          disabled
        >

        <button
          id="saveProfileButton"
          class="main-button"
          type="button"
        >
          💾 Сохранить
        </button>

        <button
          id="cancelProfileButton"
          class="cancel-button"
          type="button"
        >
          Отмена
        </button>

      </div>

    </div>

  </main>


  <!-- НИЖНЕЕ МЕНЮ -->
  <nav>

    <button
      id="chatsButton"
      class="nav-button active"
      type="button"
    >
      <span>💬</span>
      Чаты
    </button>

    <button
      id="profileButton"
      class="nav-button"
      type="button"
    >
      <span>👤</span>
      Профиль
    </button>

  </nav>

</div>


<script src="script.js"></script>

</body>
</html>