<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meowl Messenger</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="app">

  <!-- АВТОРИЗАЦИЯ -->
  <section id="auth">
    <div class="auth-card">
      <div class="logo">M</div>

      <h1>Meowl Messenger</h1>
      <p class="subtitle">Общайся. Быстро. Удобно.</p>

      <div class="tabs">
        <button id="loginTab" class="active" onclick="setMode('login')">
          Войти
        </button>

        <button id="registerTab" onclick="setMode('register')">
          Регистрация
        </button>
      </div>

      <input id="email" type="email" placeholder="Почта">
      <input id="password" type="password" placeholder="Пароль">

      <button class="main-btn" id="authBtn" onclick="authAction()">
        Войти
      </button>

      <div id="error"></div>
    </div>
  </section>


  <!-- ПРИЛОЖЕНИЕ -->
  <section id="messenger" style="display:none">

    <header>
      <div>
        <h2 id="pageTitle">Чаты</h2>
        <p id="userEmail"></p>
      </div>

      <button class="logout" onclick="logout()">Выйти</button>
    </header>


    <!-- ЧАТЫ -->
    <div id="chatsPage" class="page">

      <div class="welcome-card">
        <div class="big-icon">💬</div>
        <h2>Добро пожаловать!</h2>
        <p>Здесь будут твои чаты и сообщения.</p>
      </div>

    </div>


    <!-- ПРОФИЛЬ -->
    <div id="profilePage" class="page" style="display:none">

      <div class="profile-card">

        <div class="avatar" id="profileAvatar">👤</div>

        <h2 id="profileNickname">Пользователь</h2>

        <p id="profileDescription">
          Описание не указано
        </p>

        <div class="info">
          <span>📧 Почта</span>
          <b id="profileEmail"></b>
        </div>

        <button class="main-btn edit-btn" onclick="openEditProfile()">
          ✏️ Изменить профиль
        </button>

      </div>


      <!-- РЕДАКТИРОВАНИЕ -->
      <div id="editBox" class="profile-card edit-card" style="display:none">

        <h2>Изменить профиль</h2>

        <div class="avatar" id="editAvatar">👤</div>

        <input
          type="file"
          id="avatarInput"
          accept="image/*"
          style="display:none"
          onchange="selectAvatar(event)"
        >

        <button
          class="secondary-btn"
          onclick="document.getElementById('avatarInput').click()"
        >
          📷 Выбрать фото
        </button>

        <input
          id="nicknameInput"
          type="text"
          placeholder="Ник"
          maxlength="30"
        >

        <textarea
          id="descriptionInput"
          placeholder="Описание"
          maxlength="150"
          rows="4"
        ></textarea>

        <!-- ПОЧТА НЕ РЕДАКТИРУЕТСЯ -->
        <input
          id="emailInput"
          type="email"
          readonly
        >

        <button class="main-btn" onclick="saveProfile()">
          💾 Сохранить
        </button>

        <button class="secondary-btn" onclick="closeEditProfile()">
          Отмена
        </button>

      </div>

    </div>


    <!-- НИЖНЕЕ МЕНЮ -->
    <nav class="bottom-nav">

      <button onclick="showChats()">
        <strong>💬</strong>
        <span>Чаты</span>
      </button>

      <button onclick="showProfile()">
        <strong>👤</strong>
        <span>Профиль</span>
      </button>

    </nav>

  </section>

</div>

<script src="script.js"></script>
</body>
</html>