<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Meowl Messenger</title>

  <link rel="stylesheet" href="style.css">
</head>

<body>

<!-- ================= AUTH ================= -->

<div id="authScreen" class="auth-screen">

  <div class="auth-card">

    <div class="logo">
      🐱
    </div>

    <h1>Meowl Messenger</h1>

    <p class="auth-subtitle">
      Твой уютный мессенджер
    </p>

    <div class="auth-tabs">

      <button
        id="loginTab"
        class="auth-tab active"
        type="button"
      >
        Вход
      </button>

      <button
        id="registerTab"
        class="auth-tab"
        type="button"
      >
        Регистрация
      </button>

    </div>

    <form id="authForm">

      <div class="field">

        <label>Email</label>

        <input
          id="email"
          type="email"
          placeholder="example@mail.com"
          required
        >

      </div>

      <div class="field">

        <label>Пароль</label>

        <input
          id="password"
          type="password"
          placeholder="Введите пароль"
          required
        >

      </div>

      <button
        id="authButton"
        class="main-button"
        type="submit"
      >
        Продолжить
      </button>

    </form>

    <div
      id="authError"
      class="error-message"
    ></div>

  </div>

</div>


<!-- ================= APP ================= -->

<div id="appScreen" class="app hidden">

  <!-- HEADER -->

  <header class="topbar">

    <div class="brand">

      <div class="brand-icon">
        🐱
      </div>

      <div>
        <div class="brand-title">
          Meowl
        </div>

        <div class="brand-small">
          Messenger
        </div>
      </div>

    </div>

    <button
      id="logoutButton"
      class="logout-button"
      type="button"
    >
      ⎋
    </button>

  </header>


  <!-- ================= CHATS ================= -->

  <main
    id="chatsPage"
    class="page"
  >

    <div class="page-heading">

      <div>

        <h2>Чаты</h2>

        <p>
          Твои сообщения
        </p>

      </div>

    </div>


    <div class="chat-list">

      <!-- FAVORITES -->

      <button
        id="favoritesButton"
        class="chat-card"
        type="button"
      >

        <div class="chat-avatar favorite-avatar">
          🐱
        </div>

        <div class="chat-content">

          <div class="chat-name-row">

            <strong>
              Избранное
            </strong>

            <span>
              ⭐
            </span>

          </div>

          <p id="favoritesPreview">
            Чат с самим собой
          </p>

        </div>

        <div class="chat-arrow">
          ›
        </div>

      </button>


      <div class="no-chats">

        <div class="no-chats-icon">
          💬
        </div>

        <strong>
          Пока нет других чатов
        </strong>

        <span>
          Здесь будут появляться твои диалоги
        </span>

      </div>

    </div>

  </main>


  <!-- ================= PROFILE ================= -->

  <main
    id="profilePage"
    class="page hidden"
  >

    <div class="page-heading">

      <div>

        <h2>Профиль</h2>

        <p>
          Настрой свой аккаунт
        </p>

      </div>

    </div>


    <div class="profile-card">

      <!-- AVATAR -->

      <div
        id="profileAvatar"
        class="profile-avatar"
      >
        🐱
      </div>

      <label
        for="avatarInput"
        class="avatar-button"
      >
        📷 Изменить аватар
      </label>

      <input
        id="avatarInput"
        type="file"
        accept="image/*"
        hidden
      >


      <!-- NICKNAME -->

      <div class="field">

        <label>
          Никнейм
        </label>

        <input
          id="nicknameInput"
          type="text"
          maxlength="30"
          placeholder="Твой никнейм"
        >

      </div>


      <!-- DESCRIPTION -->

      <div class="field">

        <label>
          Описание
        </label>

        <textarea
          id="descriptionInput"
          maxlength="160"
          placeholder="Расскажи немного о себе..."
        ></textarea>

      </div>


      <!-- EMAIL -->

      <div class="field">

        <label>
          Email
        </label>

        <input
          id="profileEmail"
          type="email"
          disabled
        >

      </div>


      <button
        id="saveProfileButton"
        class="main-button"
        type="button"
      >
        Сохранить изменения
      </button>

      <div
        id="profileSaved"
        class="saved-message"
      ></div>

    </div>

  </main>


  <!-- ================= NAV ================= -->

  <nav class="bottom-nav">

    <button
      id="chatsNav"
      class="nav-item active"
      type="button"
    >

      <span>💬</span>

      <small>
        Чаты
      </small>

    </button>


    <button
      id="profileNav"
      class="nav-item"
      type="button"
    >

      <span>👤</span>

      <small>
        Профиль
      </small>

    </button>

  </nav>

</div>


<!-- ================= FAVORITES CHAT ================= -->

<div
  id="favoritesScreen"
  class="favorites-screen hidden"
>

  <div class="favorites-window">


    <!-- HEADER -->

    <header class="favorites-header">

      <button
        id="favoritesBack"
        class="back-button"
        type="button"
      >
        ←
      </button>


      <div class="favorites-user">

        <div class="favorites-avatar">
          🐱
        </div>

        <div>

          <strong>
            Избранное ⭐
          </strong>

          <span>
            Чат с самим собой
          </span>

        </div>

      </div>


      <button
        id="clearFavorites"
        class="clear-button"
        type="button"
      >
        🗑️
      </button>

    </header>


    <!-- MESSAGES -->

    <div
      id="favoritesMessages"
      class="messages"
    ></div>


    <!-- ATTACH MENU -->

    <div
      id="attachMenu"
      class="attach-menu hidden"
    >

      <button
        id="choosePhoto"
        type="button"
      >
        🖼️ Фото
      </button>

      <button
        id="chooseVideo"
        type="button"
      >
        🎥 Видео
      </button>

    </div>


    <!-- INPUT -->

    <form
      id="messageForm"
      class="message-form"
    >

      <button
        id="attachButton"
        class="attach"
        type="button"
      >
        ＋
      </button>

      <input
        id="messageInput"
        type="text"
        placeholder="Написать сообщение..."
        autocomplete="off"
      >

      <button
        class="send"
        type="submit"
      >
        ➤
      </button>

    </form>


    <input
      id="photoInput"
      type="file"
      accept="image/*"
      hidden
    >

    <input
      id="videoInput"
      type="file"
      accept="video/*"
      hidden
    >

  </div>

</div>


<script src="script.js"></script>

</body>
</html>